{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AstraScreenShare",
  "mainBinaryName": "AstraScreenShare",
  "version": "3.0.25",
  "identifier": "com.astra.screenshare",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AstraScreenShare",
    "shortDescription": "Transmita a sua tela para os amigos",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "som/astra-audio.exe": "astra-audio.exe" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerHooks": "./instalador.nsh"
      }
    }
  }
}
